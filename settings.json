{
  "permissions": {
    "deny": [
      "Agent(annie-shot-planner)",
      "Agent(annie-key-artist)",
      "Agent(annie-key-reviewer)",
      "Agent(annie-clip-artist)",
      "Agent(annie-clip-reviewer)",
      "Agent(annie-sheet-artist)",
      "Agent(annie-sheet-reviewer)",
      "Agent(annie-unity-artist)",
      "Agent(annie-tool-writer)"
    ],
    "ask": [
      "Edit(.claude/project/active.json)",
      "Write(.claude/project/active.json)"
    ]
  },
  "skillOverrides": {
    "AnimationSkills": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/repo-context.sh",
            "timeout": 5,
            "statusMessage": "Resolving repo context"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-pending.sh",
            "timeout": 5,
            "statusMessage": "Checking the active project's docs for untidied changes"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/queue-pending.sh",
            "timeout": 10,
            "statusMessage": "Reading the active project's work queue"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skills-pending.sh",
            "timeout": 10,
            "statusMessage": "Checking skills for lessons not yet absorbed"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/annie-queue-pending.sh",
            "timeout": 10,
            "statusMessage": "Reading annie's queue"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/capture-agent-metrics.sh",
            "timeout": 10,
            "statusMessage": "Recording agent performance metrics"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/capture-agent-metrics.sh",
            "timeout": 10,
            "statusMessage": "Recording agent performance metrics"
          }
        ]
      }
    ]
  }
}
