{
  "permissions": {
    "deny": [],
    "ask": [
      "Edit(.claude/project/active.json)",
      "Write(.claude/project/active.json)"
    ]
  },
  "skillOverrides": {},
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/repo-context.sh",
            "timeout": 5,
            "statusMessage": "Resolving repo context"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-pending.sh",
            "timeout": 5,
            "statusMessage": "Checking the active project's docs for untidied changes"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/queue-pending.sh",
            "timeout": 10,
            "statusMessage": "Reading the active project's work queue"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/capture-agent-metrics.sh",
            "timeout": 10,
            "statusMessage": "Recording agent performance metrics"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/capture-agent-metrics.sh",
            "timeout": 10,
            "statusMessage": "Recording agent performance metrics"
          }
        ]
      }
    ]
  }
}
