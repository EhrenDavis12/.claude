# Turning telemetry ON = loading these settings into your terminal, THEN starting claude.
#   source .claude/otel/telemetry.env
#   claude
# Everything Claude Code does in that terminal is now sent to your local stack.
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Send numbers every 10s instead of the default 60s, so the dashboard fills up fast.
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000
