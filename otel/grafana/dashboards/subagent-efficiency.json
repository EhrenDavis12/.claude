      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(increase(claude_agent_runs_total{system=~\"$system\"}[$__range]) > 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(claude_agent_turns_total{system=~\"$system\"}[$__range]) / (round(increase(claude_agent_runs_total{system=~\"$system\"}[$__range])) > 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent, system) (increase(claude_agent_tool_calls_by_tool_total{system=~\"$system\",tool=\"Bash\"}[$__range])) / (round(sum by (agent, system) (increase(claude_agent_runs_total{system=~\"$system\"}[$__range]))) > 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(claude_agent_worked_duration_seconds_total{system=~\"$system\"}[$__range]) / (round(increase(claude_agent_worked_runs_total{system=~\"$system\"}[$__range])) > 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
