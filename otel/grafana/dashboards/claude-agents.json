      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (claude_code_token_usage)", "legendFormat": "{{type}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
