      "targets": [
        { "refId": "A", "expr": "sum by (model) (rate(claude_code_cost_usage[5m]))", "legendFormat": "{{model}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ]
