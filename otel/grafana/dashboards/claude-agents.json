      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "orientation": "horizontal", "legend": { "showLegend": false } },
      "targets": [
        { "refId": "A", "expr": "sum by (agent_name) (claude_code_cost_usage{query_source=\"subagent\"})", "legendFormat": "{{agent_name}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "type": "barchart",
      "title": "Tokens per agent (subagents)  —  who reads/writes the most",
