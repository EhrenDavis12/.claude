      "targets": [
        { "refId": "A", "expr": "sum(claude_code_token_usage)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "type": "piechart",
      "title": "Cost: subagents vs main vs auxiliary",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
