      "options": { "orientation": "horizontal", "legend": { "showLegend": false } },
      "targets": [
        { "refId": "A", "expr": "sum by (agent_name) (claude_code_token_usage{query_source=\"subagent\"})", "legendFormat": "{{agent_name}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "type": "piechart",
      "title": "Tokens by type (input / output / cacheRead / cacheCreation)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
